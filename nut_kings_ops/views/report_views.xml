<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nk_quant_search" model="ir.ui.view">
        <field name="name">stock.quant.search.nutkings.ops</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <filter string="Positive Stock" name="positive_stock" domain="[('quantity', '&gt;', 0)]"/>
                <separator/>
                <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                <filter string="Lot" name="group_lot" context="{'group_by': 'lot_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_nk_inventory_levels" model="ir.actions.act_window">
        <field name="name">Current Inventory Levels</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('location_id.nk_location', '=', True), ('location_id.usage', '=', 'internal'), ('product_id.nk_inventory_type', 'in', ('raw_material', 'finished_good'))]</field>
        <field name="search_view_id" ref="view_nk_quant_search"/>
        <field name="context">{'inventory_mode': False}</field>
    </record>

    <record id="action_nk_move_history" model="ir.actions.act_window">
        <field name="name">Move History</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('move_id.picking_id.nk_is_operation', '=', True)]</field>
    </record>

    <record id="action_nk_distribution_analysis" model="ir.actions.act_window">
        <field name="name">Distribution Performance</field>
        <field name="res_model">nutkings.trip</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_nk_trip_search"/>
    </record>
</odoo>
