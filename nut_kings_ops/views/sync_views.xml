<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nk_sync_event_search" model="ir.ui.view">
        <field name="name">nutkings.sync.event.search</field>
        <field name="model">nutkings.sync.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_uid"/>
                <field name="device_name"/>
                <field name="user_id"/>
                <field name="picking_id"/>
                <filter string="Errors" name="errors" domain="[('state', '=', 'error')]"/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ('pending', 'needs_action'))]"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <separator/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Device" name="group_device" context="{'group_by': 'device_name'}"/>
                <filter string="Done by" name="group_user" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_nk_sync_event_list" model="ir.ui.view">
        <field name="name">nutkings.sync.event.list</field>
        <field name="model">nutkings.sync.event</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-danger="state == 'error'" decoration-success="state == 'processed'">
                <field name="created_on_device"/>
                <field name="received_at"/>
                <field name="transaction_kind"/>
                <field name="device_name"/>
                <field name="user_id"/>
                <field name="result_reference"/>
                <field name="state" widget="badge"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_nk_sync_event_form" model="ir.ui.view">
        <field name="name">nutkings.sync.event.form</field>
        <field name="model">nutkings.sync.event</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group><field name="external_uid"/><field name="transaction_kind"/><field name="device_name"/><field name="state"/></group>
                        <group><field name="user_id"/><field name="company_id"/><field name="created_on_device"/><field name="received_at"/><field name="processed_at"/></group>
                    </group>
                    <group string="Result"><field name="result_reference"/><field name="picking_id"/><field name="partner_id"/><field name="truck_id"/><field name="trip_id"/></group>
                    <group string="Error"><field name="error_message" nolabel="1"/></group>
                    <group string="Payload"><field name="payload" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nk_sync_events" model="ir.actions.act_window">
        <field name="name">Synchronization Log</field>
        <field name="res_model">nutkings.sync.event</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_nk_sync_event_search"/>
    </record>
</odoo>
