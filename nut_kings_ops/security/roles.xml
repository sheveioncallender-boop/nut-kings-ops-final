<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19 compatibility:
        res.groups no longer has category_id.  User-facing groups belong to a
        res.groups.privilege, and the privilege belongs to an ir.module.category.

        Each Nut Kings role has its own privilege so more than one operational
        role can be assigned to the same login without turning the roles into a
        single mutually-selected hierarchy.
    -->
    <record id="module_category_nutkings_operational_roles" model="ir.module.category">
        <field name="name">Nut Kings Operational Roles</field>
        <field name="description">Role-specific Nut Kings warehouse and van workflows.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_nutkings_office_receiving" model="res.groups.privilege">
        <field name="name">Raw Materials — Receiving</field>
        <field name="category_id" ref="module_category_nutkings_operational_roles"/>
        <field name="sequence">10</field>
    </record>
    <record id="privilege_nutkings_raw_material_issue" model="res.groups.privilege">
        <field name="name">Raw Materials — Issuing</field>
        <field name="category_id" ref="module_category_nutkings_operational_roles"/>
        <field name="sequence">20</field>
    </record>
    <record id="privilege_nutkings_finished_goods_entry" model="res.groups.privilege">
        <field name="name">Finished Goods — Receiving</field>
        <field name="category_id" ref="module_category_nutkings_operational_roles"/>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_nutkings_dispatcher" model="res.groups.privilege">
        <field name="name">Finished Goods — Issued</field>
        <field name="category_id" ref="module_category_nutkings_operational_roles"/>
        <field name="sequence">40</field>
    </record>
    <record id="privilege_nutkings_manager" model="res.groups.privilege">
        <field name="name">Nut Kings Management</field>
        <field name="category_id" ref="module_category_nutkings_operational_roles"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_nutkings_office_receiving" model="res.groups">
        <field name="name">Raw Materials — Receiving</field>
        <field name="privilege_id" ref="privilege_nutkings_office_receiving"/>
        <field name="sequence">10</field>
        <field name="comment">Receives Raw Materials into the Raw Materials warehouse.</field>
    </record>
    <record id="group_nutkings_raw_material_issue" model="res.groups">
        <field name="name">Raw Materials — Issuing</field>
        <field name="privilege_id" ref="privilege_nutkings_raw_material_issue"/>
        <field name="sequence">10</field>
        <field name="comment">Issues Raw Materials from the Raw Materials warehouse.</field>
    </record>
    <record id="group_nutkings_finished_goods_entry" model="res.groups">
        <field name="name">Finished Goods — Receiving</field>
        <field name="privilege_id" ref="privilege_nutkings_finished_goods_entry"/>
        <field name="sequence">10</field>
        <field name="comment">Records completed products entering the Finished Goods warehouse.</field>
    </record>
    <record id="group_nutkings_dispatcher" model="res.groups">
        <field name="name">Finished Goods — Issued</field>
        <field name="privilege_id" ref="privilege_nutkings_dispatcher"/>
        <field name="sequence">10</field>
        <field name="comment">Dispatches Finished Goods and loads, delivers and reconciles separate vans.</field>
    </record>
    <record id="group_nutkings_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="privilege_id" ref="privilege_nutkings_manager"/>
        <field name="sequence">10</field>
        <field name="comment">Nut Kings operational supervision and reporting. Workspace accounts and physical inventory adjustments require an Odoo administrator.</field>
    </record>
</odoo>
